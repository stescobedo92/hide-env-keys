# Build artifacts
/target
**/target/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment files (managed by evault, never commit)
.env
.env.*
!.env.example
!evault.toml.example

# Local state and caches
.evault/

# Logs
*.log

# OpenSpec (per user policy — never commit)
openspec/

# Claude Code local config (per-user, not project)
.claude/

# Plan files
.plans/

# npm
node_modules/
npm/dist/
# Downloaded binaries from the postinstall step land here at install time;
# they are NEVER committed. The repo only ships `package.json`, `README.md`,
# `LICENSE`, and the two scripts in `npm/bin/`.
npm/bin/evault
npm/bin/evault.exe

# Misc
*.bak
*.tmp
*.orig

# Coverage
*.profraw
*.lcov
tarpaulin-report.html
